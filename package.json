{
  "name": "hotel-expert-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "tsx scripts/serve.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "node scripts/check.mjs && tsc --noEmit",
    "start": "node server/start.js",
    "db:local": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:status": "node scripts/local-postgres.mjs status",
    "db:migrate": "node scripts/migrate.mjs",
    "test:db": "node scripts/test-postgres.mjs",
    "db:backup": "node scripts/backup.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.3"
  }
}
