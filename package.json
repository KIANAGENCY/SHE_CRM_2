{
  "name": "hotel-expert-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "tsx scripts/serve.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsx scripts/check.ts && tsc --noEmit",
    "start": "tsx server/start.ts",
    "db:local": "tsx scripts/local-postgres.ts start",
    "db:stop": "tsx scripts/local-postgres.ts stop",
    "db:status": "tsx scripts/local-postgres.ts status",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:db": "tsx scripts/test-postgres.ts",
    "db:backup": "tsx scripts/backup.ts",
    "sara:migration": "tsx scripts/sara-migration.ts",
    "sara:restore": "tsx scripts/sara-migration.ts restore migration/sara-crm.enc"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.3"
  }
}
